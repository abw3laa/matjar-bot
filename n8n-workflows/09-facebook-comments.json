        "respondWith": "text",
        "responseBody": "={{$json.query[\"hub.challenge\"]}}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "node_respond_forbidden",
      "name": "Respond - Forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
