      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        100
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.query[\"hub.verify_token\"]}}",
              "value2": "={{$env.FACEBOOK_VERIFY_TOKEN}}",
