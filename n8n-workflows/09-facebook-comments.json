      "typeVersion": 2,
      "position": [
        180,
        100
      ],
      "notes": "نفس آلية تحقق Meta المستخدمة مع WhatsApp — لكن بمسار منفصل ورمز تحقق قد يختلف: FACEBOOK_VERIFY_TOKEN.",
      "parameters": {
        "httpMethod": "GET",
        "path": "facebook/comments-webhook",
        "responseMode": "responseNode",
        "options": {}
