    {
      "id": "node_execute_admin_notification",
      "name": "Execute - Admin Notification Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2380,
        820
      ],
      "notes": "بعد استيراد Workflow '05 - Admin Notification'، افتح هذه العقدة واختره من القائمة المنسدلة. يُستدعى هنا لأن طلبات الدفع عند الاستلام تصل مباشرة لحالة بانتظار المراجعة دون حاجة لإثبات تحويل.",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "05 - Admin Notification"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "order_id": "={{$('Workflow Trigger').item.json.active_order_id}}"
          }
        }
      }
    }
  ],
